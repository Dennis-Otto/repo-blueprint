    pr["Pull request<br>feat: … · fix: … · feat!: …<br>auto-merge on"]
    line["The branch bot brings it<br>up to date with main<br>in its turn"]
    checks{"Every required<br>check passes?"}
    main["Squashed into main<br>the title decides<br>the next version"]

    issue --> branch --> change --> push --> pr --> line --> checks
