[#- The composer.json of a Nextcloud app: the blueprint's stack with the app's name,
    description, license and namespace. composer.json and composer.lock both use it. -#]
[%- from "includes/replace.jinja" import replaced with context -%]
{= replaced("stacks/php/composer.json", [
    ['"name": "blueprint/nextcloud-app"', '"name": "' ~ (owner | lower) ~ '/' ~ project_slug ~ '"'],
    ['"description": "Development tools of the Nextcloud apps of the blueprint"', '"description": ' ~ (description | to_json(ensure_ascii=False))],
    ['"license": "AGPL-3.0-or-later"', '"license": "' ~ license ~ '"'],
    ['OCA\\\\Blueprint', 'OCA\\\\' ~ nextcloud_namespace],
]) -=}
