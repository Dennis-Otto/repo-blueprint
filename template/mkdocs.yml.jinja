# The documentation website: MkDocs with the Material theme builds it from the pages
# in docs/, and the Docs workflow publishes it on GitHub Pages with every change of
# main. This file belongs to the project: the blueprint writes it once, and its
# updates leave it as it is. The settings that every website shares come from
# .github/mkdocs-blueprint.yml, which the blueprint keeps current; a setting here
# wins over the same one there. Preview the website while you write with
#   pip install --require-hashes -r .github/docs-requirements.txt && mkdocs serve
# https://squidfunk.github.io/mkdocs-material/
INHERIT: .github/mkdocs-blueprint.yml
site_name: {= project_name | to_json(ensure_ascii=False) =}
site_description: {= description | to_json(ensure_ascii=False) =}
# The website of the owner itself lives at the root of its address.
site_url: https://{= owner | lower =}.github.io/[% if project_slug != (owner | lower) ~ '.github.io' %]{= project_slug =}/[% endif %]
repo_url: https://github.com/{= owner =}/{= project_slug =}
repo_name: {= owner =}/{= project_slug =}
copyright: {= ('© ' ~ copyright) | to_json(ensure_ascii=False) =}

# A website in more than one language: the pages of another language sit next to
# their English ones, such as index.de.md beside index.md, and a switch in the header
# changes between them.
# plugins:
#   search:
#     lang: [en, de]
#   i18n:
#     enabled: true
#     languages:
#       - locale: en
#         name: English
#         default: true
#         build: true
#       - locale: de
#         name: Deutsch
#         build: true

# The menu. A tab in the header for each section.
nav:
  - Home: index.md
  - Security design: security.md
  - Decisions: decisions/README.md
