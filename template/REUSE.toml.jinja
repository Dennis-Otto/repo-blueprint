# The license of every file, in the machine-readable form of REUSE
# (https://reuse.software); the Lint workflow checks it.
version = 1

[[annotations]]
path = "**"
precedence = "aggregate"
SPDX-FileCopyrightText = "{= copyright_year =} {= author =} and contributors"
SPDX-License-Identifier = "{= license =}"
