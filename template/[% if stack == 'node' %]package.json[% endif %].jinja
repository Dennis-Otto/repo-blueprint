[#- The tools of the stack: those of a Worker, those of an extension, with the types of
    Chrome, or those of every other package of Node. -#]
[%- set registry -%][% if project_type == 'cloudflare-worker' %][% include "stacks/worker/package.json" %][% elif project_type == 'chrome-extension' %][% include "stacks/extension/package.json" %][% else %][% include "stacks/node/package.json" %][% endif %][%- endset -%]
[%- set stack_manifest = registry | from_json -%]
{
  "name": "{= project_slug =}",
  "version": "0.0.0",
[%- if publish_to != 'npm' %]
  "private": true,
[%- endif %]
  "description": {= description | to_json(ensure_ascii=False) =},
  "homepage": "https://github.com/{= owner =}/{= project_slug =}#readme",
  "bugs": {
    "url": "https://github.com/{= owner =}/{= project_slug =}/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{= owner =}/{= project_slug =}.git"
  },
  "license": "{= license =}",
  "author": {= author | to_json(ensure_ascii=False) =},
  "type": "module",
[%- if project_type == 'node-package' %]
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
[%- endif %]
  "engines": {
[%- for name, version in stack_manifest.engines.items() %]
    {= name | to_json(ensure_ascii=False) =}: {= version | to_json(ensure_ascii=False) =}[% if not loop.last %],[% endif %]
[%- endfor %]
  },
  "scripts": {
[%- if project_type == 'cloudflare-worker' %]
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "bash scripts/deploy-worker.sh",
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc --project tsconfig.json",
    "test": "vitest run --coverage"
[%- else %]
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.ts\""[% if project_type == 'chrome-extension' %],
    "package": "bash scripts/package-extension.sh",
    "e2e": "node scripts/load-extension.mjs"[% endif %]
[%- endif %]
  },
  "devDependencies": {
[%- for name, version in stack_manifest.devDependencies.items() %]
    {= name | to_json(ensure_ascii=False) =}: {= version | to_json(ensure_ascii=False) =}[% if not loop.last %],[% endif %]
[%- endfor %]
  }
}
