[#- The lock of the blueprint's stack, with the content hash of this app's composer.json,
    computed as Composer does: the MD5 of the relevant keys, sorted, in the JSON of PHP. -#]
[%- set manifest -%][% include "includes/composer.json.jinja" %][%- endset -%]
[%- set content = manifest | from_json -%]
[%- set relevant = {} -%]
[%- for key in ['config', 'conflict', 'extra', 'minimum-stability', 'name', 'prefer-stable', 'provide', 'replace', 'repositories', 'require', 'require-dev', 'version'] -%]
[%- if key == 'config' -%]
[%- if 'platform' in content.get('config', {}) -%][%- set _ = relevant.update({'config': {'platform': content.config.platform}}) -%][%- endif -%]
[%- elif key in content -%][%- set _ = relevant.update({key: content[key]}) -%][%- endif -%]
[%- endfor -%]
[%- set content_hash = relevant | to_json(separators=(',', ':')) | replace('/', '\\/') | replace(':{}', ':[]') | hash('md5') -%]
[%- filter regex_replace('"content-hash": "[0-9a-f]+"', '"content-hash": "' ~ content_hash ~ '"') -%]
[% include "stacks/php/composer.lock" %]
[%- endfilter -%]
