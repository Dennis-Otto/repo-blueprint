// Loads the unpacked extension, extension/ as `npm run build` leaves it, into Chrome for
// Testing and checks that Chrome takes it: its service worker starts, and it reports
// the name and the version of the manifest. A manifest that Chrome refuses, a script
// that the manifest names but the build didn't write, or a service worker that throws
// as it starts fails here, before a user or the review of the store finds it.
//
//   npm run build
//   node scripts/load-extension.mjs "$(bash scripts/chrome-for-testing.sh)"
//
// The first argument is the executable of Chrome for Testing, or else the variable
// CHROME. It talks to Chrome over its DevTools protocol with the WebSocket of Node,
// and needs no package. The CI of a Chrome extension runs it after the checks.
//
// The blueprint keeps this file current: https://github.com/Dennis-Otto/repo-blueprint
import { spawn } from "node:child_process";
import { mkdtempSync, readFileSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";

const TIMEOUT_MS = 30_000;

const fail = (text) => {
  console.error(`::error title=Extension::${text}`);
  process.exit(1);
};

const chrome = process.argv[2] ?? process.env.CHROME;
if (!chrome) {
  fail(
    'Name the executable of Chrome for Testing: node scripts/load-extension.mjs "$(bash scripts/chrome-for-testing.sh)"',
  );
}
const extension = resolve("extension");
const manifest = JSON.parse(
  readFileSync(join(extension, "manifest.json"), "utf8"),
);
const worker = manifest.background?.service_worker;
if (worker === undefined) {
  console.log(
    "extension/manifest.json names no service worker, so nothing starts that this check could ask.",
  );
  process.exit(0);
}

const profile = mkdtempSync(join(tmpdir(), "load-extension-"));
const browser = spawn(
  chrome,
  [
    "--headless=new",
    `--user-data-dir=${profile}`,
    "--remote-debugging-port=0",
    `--disable-extensions-except=${extension}`,
    `--load-extension=${extension}`,
    "--no-first-run",
    "--no-default-browser-check",
    // The runners of GitHub have no user namespaces for the sandbox of Chrome.
    ...(process.platform === "linux" && process.env.CI ? ["--no-sandbox"] : []),
    "about:blank",
  ],
  { stdio: ["ignore", "ignore", "pipe"] },
);
let log = "";
const stop = (code) => {
  browser.kill();
  try {
    rmSync(profile, { recursive: true, force: true, maxRetries: 5 });
  } catch {
    // Chrome may still hold its profile as it ends; the folder is a temporary one.
  }
  process.exit(code);
};
const timer = setTimeout(() => {
  console.error(log);
  console.error(
    `::error title=Extension::Chrome started no service worker of the extension within ${TIMEOUT_MS / 1000} seconds: the log of Chrome above names what it refused, such as the manifest or ${worker}.`,
  );
  stop(1);
}, TIMEOUT_MS);

// Chrome names the address of its DevTools protocol on its error output.
const address = await new Promise((done) => {
  browser.stderr.setEncoding("utf8");
  browser.stderr.on("data", (chunk) => {
    log += chunk;
    const found = /DevTools listening on (ws:\/\/\S+)/.exec(log);
    if (found) done(found[1]);
  });
  browser.on("exit", (code) => {
    console.error(log);
    fail(`Chrome ended with the code ${code} before it took the extension.`);
  });
});

const socket = new WebSocket(address);
await new Promise((done, error) => {
  socket.addEventListener("open", done, { once: true });
  socket.addEventListener("error", error, { once: true });
});
let next = 0;
const waiting = new Map();
socket.addEventListener("message", ({ data }) => {
  const answer = JSON.parse(data);
  waiting.get(answer.id)?.(answer);
  waiting.delete(answer.id);
});
const send = (method, params = {}, sessionId = undefined) =>
  new Promise((done) => {
    next += 1;
    waiting.set(next, done);
    socket.send(JSON.stringify({ id: next, method, params, sessionId }));
  });

// The service worker of the extension, once Chrome has started it for the install.
const path = worker.replace(/^\.?\//, "");
let target;
while (target === undefined) {
  const { result } = await send("Target.getTargets");
  target = result.targetInfos.find(
    (info) =>
      info.type === "service_worker" &&
      /^chrome-extension:\/\/[a-p]{32}\//.test(info.url) &&
      info.url.endsWith(`/${path}`),
  );
  if (target === undefined) {
    await new Promise((done) => setTimeout(done, 250));
  }
}
const { result: attached } = await send("Target.attachToTarget", {
  targetId: target.targetId,
  flatten: true,
});
// The worker may still start as Chrome lists it, and answers once its script ran.
let loaded;
while (loaded === undefined) {
  const answer = await send(
    "Runtime.evaluate",
    {
      expression:
        "JSON.stringify({ name: chrome.runtime.getManifest().name, version: chrome.runtime.getManifest().version })",
      returnByValue: true,
    },
    attached.sessionId,
  );
  const value = answer.result?.result?.value;
  if (typeof value === "string") {
    loaded = JSON.parse(value);
  } else {
    await new Promise((done) => setTimeout(done, 250));
  }
}
clearTimeout(timer);
if (loaded.version !== manifest.version) {
  console.error(
    `::error title=Extension::Chrome runs the version ${loaded.version} of the extension, not ${manifest.version} of extension/manifest.json.`,
  );
  stop(1);
}
console.log(
  `Chrome loaded ${loaded.name} ${loaded.version} from extension/, and its service worker ${path} runs.`,
);
socket.close();
stop(0);
