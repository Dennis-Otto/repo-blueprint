[#- The license text. The short licenses get one copyright line per holder of the
    answer copyright, in the places of their SPDX texts; the others stay verbatim,
    appendix included. -#]
[%- set text -%][% include "LICENSES/" ~ license ~ ".txt" %][%- endset -%]
[#- Some SPDX texts end with a blank line, which LICENSE leaves out. -#]
[%- set text = text.rstrip() -%]
[%- set holders = copyright.split(';') | map('trim') | select | list -%]
[%- if license in ['MIT', 'MIT-0', 'BSD-3-Clause'] -%]
{= text
   | replace('Copyright (c) [year] [fullname]', holders | map('regex_replace', '^', 'Copyright (c) ') | join('\n'))
   | replace('Copyright <YEAR> <COPYRIGHT HOLDER>', holders | map('regex_replace', '^', 'Copyright ') | join('\n'))
   | replace('Copyright (c) <year> <owner>. ', holders | map('regex_replace', '^', 'Copyright (c) ') | map('regex_replace', '$', '.') | join('\n')) =}
[%- else -%]
{= text =}
[%- endif %]
