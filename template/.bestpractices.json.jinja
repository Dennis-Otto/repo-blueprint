[#- The answers of the OpenSSF Best Practices badge (https://www.bestpractices.dev)
    that the blueprint guarantees for every repository made from it: the criteria of
    the levels passing and silver and of the OSPS Baseline that its files, workflows
    and settings as code meet, each with the file that shows it. bestpractices.dev
    reads the file and proposes these answers, also after a change of the file once
    a maintainer presses "Save (and continue)" with the robot. What depends on the
    software or on the people of a project is left out: bestpractices.dev keeps the
    answers that a maintainer gives there for it. -#]
[%- set repository = 'https://github.com/' ~ owner ~ '/' ~ project_slug -%]
[%- set files = repository ~ '/blob/main/' -%]
[#- The test runner of the kinds whose scripts/check.sh runs a test suite. -#]
[%- set tests = {'python': 'pytest', 'home-assistant': 'pytest', 'php': 'PHPUnit', 'node': 'npm test'}.get(stack, '') -%]
[%- set linters = {'python': ', Ruff, mypy', 'home-assistant': ', Ruff, mypy', 'php': ', php-cs-fixer, Psalm', 'node': ', Biome, the TypeScript compiler', }.get(stack, '') -%]
[#- The manifest of the direct dependencies, and what lists and pins them. -#]
[%- set dependencies = {
  'python': ('requirements-dev.in', 'pyproject.toml and requirements-dev.in list the direct dependencies, and requirements-dev.txt pins each with its hashes'),
  'home-assistant': ('requirements-test.in', 'pyproject.toml and requirements-test.in list the direct dependencies, and requirements-test.txt pins each with its hashes'),
  'php': ('composer.json', 'composer.json lists the direct dependencies, and composer.lock pins each'),
  'node': ('package.json', 'package.json lists the direct dependencies, and package-lock.json pins each with its hash'),
}.get(stack) -%]
[%- set registry = {'pypi': ' and from PyPI', 'npm': ' and from npm', 'ghcr': ' and from the GitHub Container Registry', 'nextcloud-appstore': ' and from the Nextcloud App Store'}.get(publish_to, '') -%]
[#- Every site of the project is on GitHub: the repository and, on GitHub Pages, the website. -#]
[%- set on_github = not homepage or homepage.startswith('https://' ~ (owner | lower) ~ '.github.io/') -%]
[%- set channels = 'GitHub Issues and pull requests' ~ (', and GitHub Discussions' if discussions else '') -%]
