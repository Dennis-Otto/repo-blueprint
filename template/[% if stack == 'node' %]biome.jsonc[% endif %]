// The lint and the format of the code, which Biome checks in the step "Lint and
// format" of scripts/check.sh with `npx --no -- biome ci --error-on-warnings .`;
// `npx --no -- biome check --write .` fixes what it can. Biome checks the code and the JSON of the package that git
// doesn't ignore, in the indentation of .editorconfig, with its recommended rules
// and sorted imports. It leaves out .github/, the tools and the settings of the
// bots, which keep the format of the blueprint, Markdown and YAML, which Biome
// formats since 2.6: markdownlint checks the Markdown, and the blueprint renders
// both in the format they keep, and the pictures that scripts/diagrams.sh draws into
// docs/images/diagrams, whose code Mermaid writes and the next drawing writes again.
//
// The manifest of an extension keeps the format of release-please, which writes the
// version into it on every release pull request and puts each item of an array on a
// line of its own, where Biome would keep a short array on one line.
//
// The blueprint keeps this file current: https://github.com/Dennis-Otto/repo-blueprint
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.github",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml",
      "!docs/images/diagrams"
    ]
  },
  "overrides": [
    {
      "includes": ["extension/manifest.json"],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ],
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
