[#- The lock of the blueprint's stack, with the name and license of this package. -#]
[%- filter replace('"name": "blueprint-node-package"', '"name": "' ~ project_slug ~ '"')
    | replace('"license": "MIT"', '"license": "' ~ license ~ '"', 1) -%]
