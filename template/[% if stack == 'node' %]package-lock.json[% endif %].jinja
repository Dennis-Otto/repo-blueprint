[#- The lock of the blueprint's stack, with the name and license of this package. -#]
[%- from "includes/replace.jinja" import replaced with context -%]
[%- set stack_dir = {"cloudflare-worker": "worker", "chrome-extension": "extension"}.get(project_type, "node") -%]
[%- set stack_lock = "stacks/" ~ stack_dir ~ "/package-lock.json" -%]
[%- set stack_name = {"worker": "blueprint-cloudflare-worker", "extension": "blueprint-chrome-extension"}.get(stack_dir, "blueprint-node-package") -%]
{= replaced(stack_lock, [['"name": "' ~ stack_name ~ '"', '"name": "' ~ project_slug ~ '"'], ['"license": "MIT"', '"license": "' ~ license ~ '"', 1]]) -=}
