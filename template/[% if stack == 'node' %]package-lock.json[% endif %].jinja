[#- The lock of the blueprint's stack, with the name and license of this package. -#]
[%- from "includes/replace.jinja" import replaced with context -%]
[%- set stack_lock = "stacks/worker/package-lock.json" if project_type == 'cloudflare-worker' else "stacks/node/package-lock.json" -%]
[%- set stack_name = "blueprint-cloudflare-worker" if project_type == 'cloudflare-worker' else "blueprint-node-package" -%]
{= replaced(stack_lock, [['"name": "' ~ stack_name ~ '"', '"name": "' ~ project_slug ~ '"'], ['"license": "MIT"', '"license": "' ~ license ~ '"', 1]]) -=}
