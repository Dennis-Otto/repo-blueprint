<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{= project_name | e =}: social preview</title>
<!-- scripts/social-preview.sh renders this page into the 1280×640 image that GitHub
     shows for links to the repository. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=block">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 1280px; height: 640px; overflow: hidden; }
body {
  --accent: [% if project_type == 'home-assistant' %]#41bdf5[% elif project_type == 'nextcloud-app' %]#7aa2ff[% elif project_type == 'github-action' %]#a78bfa[% elif project_type == 'python-package' %]#facc15[% elif project_type == 'node-package' %]#4ade80[% elif project_type == 'container' %]#22d3ee[% else %]#94a3b8[% endif %];
  position: relative;
  font-family: "Inter", "Liberation Sans", "FreeSans", sans-serif;
  color: #f8fafc;
  background:
    radial-gradient(760px 560px at 78% 52%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 72%),
    linear-gradient(135deg, #0a0f1d 0%, #0c1424 55%, #0b1a24 100%);
}
.left { position: absolute; left: 72px; top: 0; bottom: 0; width: 540px; display: flex; flex-direction: column; justify-content: center; }
.logo { width: 96px; height: 96px; margin-bottom: 36px; }
.logo svg, .logo img { width: 100%; height: 100%; display: block; }
h1 { font-size: [% if project_name | length > 18 %]54px[% else %]64px[% endif %]; font-weight: 800; line-height: 1.04; letter-spacing: -0.025em; }
.subtitle { margin-top: 12px; font-size: 38px; font-weight: 700; color: var(--accent); letter-spacing: -0.015em; }
.text { margin-top: 36px; font-size: 25px; line-height: 1.45; color: #cbd5e1; }
ul { margin-top: 40px; list-style: none; display: grid; gap: 16px; }
li { font-size: 24px; color: #cbd5e1; display: flex; align-items: center; gap: 18px; }
li::before { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 14px var(--accent); flex: none; }
.panel { position: absolute; right: 64px; top: 50%; transform: translateY(-50%); width: 548px; }
.card { background: #141a26; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 20px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45), 0 0 70px color-mix(in srgb, var(--accent) 16%, transparent); }
.muted { color: #8b95a7; }
.mono { font-family: "JetBrains Mono", "Liberation Mono", monospace; }

.checks { padding: 26px 30px; }
.repo { display: flex; align-items: center; justify-content: space-between; font-size: 18px; color: #e2e8f0; padding-bottom: 16px; margin-bottom: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
.branch { font-size: 14px; color: #8b95a7; border: 1px solid #334155; border-radius: 999px; padding: 2px 10px; }
.check { display: flex; align-items: center; gap: 14px; font-size: 20px; line-height: 2.4; color: #cbd5e1; }
.check svg { width: 22px; height: 22px; color: #4ade80; flex: none; }
.check b { color: #f8fafc; font-weight: 600; }
.monogram { width: 96px; height: 96px; border-radius: 22px; display: grid; place-items: center; font-size: 42px; font-weight: 800; color: #0a0f1d;
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 55%, white), var(--accent)); }

</style>
</head>
<body>
<div class="left">
  <div class="logo"><div class="monogram">{= (project_name.split() | map('first') | join)[:2] | upper | e =}</div></div>
  <h1>{= project_name | e =}</h1>
[% if project_type != 'generic' %]  <div class="subtitle">[% if project_type == 'home-assistant' %]for Home Assistant[% elif project_type == 'nextcloud-app' %]for Nextcloud[% elif project_type == 'github-action' %]GitHub Action[% elif project_type == 'python-package' %]Python package[% elif project_type == 'node-package' %]Node package[% else %]Container image[% endif %]</div>
[% endif %]  <p class="text">{= description | e =}</p>
</div>
<div class="panel">
  <div class="card checks">
    <div class="repo"><span class="mono">{= owner =}/{= project_slug =}</span><span class="branch mono">main</span></div>
    <div class="check"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M13.8 3.3a1 1 0 0 1 0 1.4l-7 7a1 1 0 0 1-1.4 0l-3.2-3.2a1 1 0 1 1 1.4-1.4l2.5 2.5 6.3-6.3a1 1 0 0 1 1.4 0z"/></svg><span><b>Checks</b> on every change</span></div>
    <div class="check"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M13.8 3.3a1 1 0 0 1 0 1.4l-7 7a1 1 0 0 1-1.4 0l-3.2-3.2a1 1 0 1 1 1.4-1.4l2.5 2.5 6.3-6.3a1 1 0 0 1 1.4 0z"/></svg><span><b>CodeQL</b> · Scorecard · secret scan</span></div>
    <div class="check"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M13.8 3.3a1 1 0 0 1 0 1.4l-7 7a1 1 0 0 1-1.4 0l-3.2-3.2a1 1 0 1 1 1.4-1.4l2.5 2.5 6.3-6.3a1 1 0 0 1 1.4 0z"/></svg><span><b>Releases</b> with SBOM and provenance</span></div>
    <div class="check"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M13.8 3.3a1 1 0 0 1 0 1.4l-7 7a1 1 0 0 1-1.4 0l-3.2-3.2a1 1 0 1 1 1.4-1.4l2.5 2.5 6.3-6.3a1 1 0 0 1 1.4 0z"/></svg><span><b>Issue assistant</b> · Dependabot</span></div>
  </div>
</div>
</body>
</html>
