# Findings of code scanning that this repository accepts, each with its reason.
# The Findings workflow of the issue assistant dismisses matching alerts with this
# reason and fails while any other alert is open:
# https://github.com/Dennis-Otto/issue-assistant#findings

[[accept]]
tool = "Scorecard"
rule = "CodeReviewID"
reason = "won't fix"
comment = "One maintainer: nobody else can approve a pull request. Every change still goes through a pull request with all required checks."

[[accept]]
tool = "Scorecard"
rule = "BranchProtectionID"
reason = "won't fix"
comment = "Required approvals would block the only maintainer. main requires pull requests, all checks, linear history and no force pushes."

[[accept]]
tool = "Scorecard"
rule = "MaintainedID"
reason = "won't fix"
comment = "Scorecard counts a repository younger than 90 days as unmaintained; this one gets commits every week."
[% if stack in ['php', 'container', 'generic', 'home-assistant'] %]
[[accept]]
tool = "Scorecard"
rule = "FuzzingID"
reason = "won't fix"
[%- if stack == 'home-assistant' %]
comment = "Scorecard counts only Atheris as fuzzing of Python, and Atheris doesn't support the Python of Home Assistant. Property tests with Hypothesis run on every change."
[%- elif stack == 'php' %]
comment = "Scorecard detects no fuzzing of PHP. The tests run on every change."
[%- else %]
comment = "Scorecard detects no fuzzing for this kind of project. Its checks run on every change."
[%- endif %]
[% endif -%]
