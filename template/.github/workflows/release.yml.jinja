[%- from "includes/replace.jinja" import replaced with context -%]
[#- The build of a Nextcloud app signs it with the key of its environment signing,
    which a called workflow sees only when the caller passes that one secret on;
    every other build gets none. -#]
[%- set nothing = "    # The build gets none of the secrets of the release, only the token of its job.\n" -%]
[%- set signing = "    # The build signs the Nextcloud app with the key of its environment signing. A\n    # called workflow sees no secret that its caller doesn't pass, and the secret of\n    # the environment of the called job takes the place of the value passed, which is\n    # empty as this job enters no environment. No other secret reaches the build.\n    secrets:\n      APP_PRIVATE_KEY: ${{ secrets.APP_PRIVATE_KEY }}\n" -%]
{= replaced(".github/workflows/release.yml", [[nothing, signing if publish_to == 'nextcloud-appstore' else nothing]]) -=}
