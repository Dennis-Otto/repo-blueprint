[%- from "includes/replace.jinja" import replaced with context -%]
[#- Only a Nextcloud app needs a secret in its build, the key that signs it, so only
    its build enters signing, the environment of that key alone; every other build
    holds no secret but the token of its job. -#]
[%- set nothing = "    # No environment and no secret but the token of the job, so that no action of\n    # the build can reach the private key of the release app.\n" -%]
[%- set signing = "    # The key that signs a Nextcloud app is the one secret of this environment, which\n    # the build of no other kind of project enters: no action of the build can reach\n    # the private key of the release app or the token of the App Store.\n    environment:\n      name: signing\n      deployment: false\n" -%]
{= replaced(".github/workflows/build-release.yml", [[nothing, signing if publish_to == 'nextcloud-appstore' else nothing]]) -=}
