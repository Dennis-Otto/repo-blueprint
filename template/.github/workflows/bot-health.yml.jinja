[%- from "includes/replace.jinja" import replaced with context -%]
[%- set blueprint = "    # The bots and the scheduled workflows of every repository; then those of the blueprint alone.\n    workflows: [Blueprint update, Clean-up, Findings, Fuzzing, Issue lifecycle, Labels, Links, Mutation, OSV-Scanner, OpenSSF Scorecard, Property tests, Release, Release verification, SBOM, Screenshots, Settings, Update branches, Upstream, Workflow security, Dashboard, Docs pictures, Issue assistant sync, Renovate, Rollout, Weekly report]\n" -%]
[%- set project = "    # The bots and the scheduled workflows of every repository; the daily look covers those of the project.\n    workflows: [Blueprint update, Clean-up, Findings, Fuzzing, Issue lifecycle, Labels, Links, Mutation, OSV-Scanner, OpenSSF Scorecard, Property tests, Release, Release verification, SBOM, Screenshots, Settings, Update branches, Upstream, Workflow security" ~ (", Renovate" if renovate_runner == 'self' else "") ~ "]\n" -%]
{= replaced(".github/workflows/bot-health.yml", [[blueprint, project]]) -=}
