[%- from "includes/replace.jinja" import replaced with context -%]
[%- set blueprint = "    # The bots and the scheduled workflows of every repository, its bots of events and the workflows with an issue of their own; then those of the blueprint alone.\n    workflows: [Blueprint update, Chrome Web Store, Clean-up, Findings, Fuzzing, Issue lifecycle, Labels, Links, Mutation, OSV-Scanner, OpenSSF Scorecard, Property tests, Release, Release verification, SBOM, Screenshots, Settings, Update branches, Upstream, Workflow security, Area labels, Commands, Dependabot maintenance, Welcome, Diagrams, Newest Node, Newest Python, Dashboard, Docs pictures, Issue assistant sync, Next runner, Renovate, Rollout, Weekly report]\n" -%]
[%- set project = "    # The bots and the scheduled workflows of every repository, its bots of events and the workflows with an issue of their own; the daily look covers those of the project.\n    workflows: [Blueprint update, Chrome Web Store, Clean-up, Findings, Fuzzing, Issue lifecycle, Labels, Links, Mutation, OSV-Scanner, OpenSSF Scorecard, Property tests, Release, Release verification, SBOM, Screenshots, Settings, Update branches, Upstream, Workflow security, Area labels, Commands, Dependabot maintenance, Welcome, Diagrams, Newest Node, Newest Python" ~ (", Renovate" if renovate_runner == 'self' else "") ~ "]\n" -%]
{= replaced(".github/workflows/bot-health.yml", [[blueprint, project]]) -=}
