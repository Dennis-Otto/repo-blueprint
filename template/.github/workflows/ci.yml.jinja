[%- from "includes/replace.jinja" import by_hand, replaced with context -%]
[#- The checks of each stack, without the jobs that only the blueprint skips; those of
    Python are the blueprint's own CI, which runs every job. -#]
[%- set guard = "    # Not in the blueprint itself; generated repositories don't have this line.\n    if: github.repository != 'Dennis-Otto/repo-blueprint'\n" -%]
[#- The triggers of a repository, the same as those of CI (python); the blueprint starts
    the checks of the other stacks only by hand. -#]
[%- set triggers -%]
on:
  push:
    branches: [main]
  pull_request:
  # Each week on main as well, so that what no commit changes, such as a new rule of a
  # tool, fails here and repairs itself through the fix bot, not in the next pull
  # request. At the time of Lint, so that one commit of the bot holds what both fix.
  schedule:
    - cron: "30 4 * * 3"
[% endset -%]
[%- set home_assistant -%]
on:
  push:
    branches: [main]
  pull_request:
  schedule:
    # HACS and hassfest apply new rules without a release of this repository, and what
    # no commit changes fails here and repairs itself through the fix bot, not in the
    # next pull request. At the time of Lint, so that one commit of the bot holds what
    # both fix.
    - cron: "30 4 * * 3"
[% endset -%]
[%- set pairs = [[by_hand, home_assistant if ci_workflow == 'home-assistant' else triggers], [guard, ""]] -%]
{= replaced(".github/workflows/ci-" ~ ci_workflow ~ ".yml", [] if ci_workflow == 'python' else pairs) -=}
