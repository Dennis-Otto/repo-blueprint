[#- The Renovate workflow of the blueprint, for this repository alone: one job, without
    the list of the repositories and without the job that brings their logs together,
    which would only cost minutes here. Its token of the release app is for this
    repository by default, and the job keeps the issue of Renovate's problems itself. -#]
[%- from "includes/replace.jinja" import replaced with context -%]
[%- set list_of_repositories = ["  repositories:\n    name: repositories of Renovate\n", "  renovate:\n    name: renovate "] -%]
[%- set log_and_report = ["      # The job problems brings the log of each repository into the one issue.\n", "      # A warning, such as a lock file that Renovate can't read, ends no run with a\n"] -%]
[%- set end_of_report = ["      - name: Wait until Harden-Runner has removed Docker\n", none] -%]
[%- set matrix = "    name: renovate ${{ matrix.repo }}\n    needs: repositories\n    if: needs.repositories.outputs.repositories != ''\n" -%]
[%- set alone = "    name: renovate\n    if: github.event_name != 'pull_request'\n" -%]
[%- set strategy = "    strategy:\n      # Two at a time, as the owner has about 20 jobs at once for all of its\n      # repositories, and every repository, also after one that failed.\n      max-parallel: 2\n      fail-fast: false\n      matrix:\n        repo: ${{ fromJSON(needs.repositories.outputs.repositories) }}\n" -%]
[%- set permissions = "      deployment: false\n    permissions:\n      contents: read\n" -%]
[%- set issue = permissions ~ "      # The one issue with the warnings and errors of Renovate.\n      issues: write\n" -%]
[%- set token = "          # For this repository alone: a package manager that runs code of a dependency\n          # while it writes a lock file can't push to another repository of the owner.\n          owner: ${{ github.repository_owner }}\n          repositories: ${{ matrix.repo }}\n" -%]
{= replaced(".github/workflows/renovate.yml", [
  [matrix, alone],
  ["      group: renovate-${{ matrix.repo }}\n", "      group: renovate\n"],
  [strategy, ""],
  [permissions, issue],
  [token, ""],
  ["${{ github.repository_owner }}/${{ matrix.repo }}", "${{ github.repository }}"],
  ['"$RUNNER_TEMP"/problems/*/problems.json', "/tmp/renovate/problems.json"],
], [list_of_repositories, log_and_report, end_of_report]) -=}
