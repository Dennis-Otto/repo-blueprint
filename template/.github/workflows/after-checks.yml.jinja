[%- from "includes/replace.jinja" import replaced with context -%]
[%- set workflows = "    # The workflows of the checks of this repository; the blueprint sets them for each kind of project.\n    # Then those of the other required checks and of the scanners, the same in every repository, and the release.\n    workflows: [CI (python), Variants, Windows, Issue assistant sync, Downstream, " -%]
[%- set tests = test_workflows.split(',') | map('trim') | select | join(', ') -%]
[%- set project = "    # The checks of this repository, its end-to-end tests if a workflow of its own named Docker E2E runs them,\n    # and the workflows of its other tests that the answer test_workflows of the blueprint names.\n    # Then those of the other required checks and of the scanners, the same in every repository, and the release.\n    workflows: [CI (" ~ ci_workflow ~ ")" ~ (", Action test" if project_type == 'github-action' else "") ~ ", Docker E2E, " ~ ((tests ~ ", ") if tests else "") -%]
{= replaced(".github/workflows/after-checks.yml", [[workflows, project]]) -=}
