[% set workflows = "    # The workflows of the checks of this repository; the blueprint sets them for each kind of project.\n    # Then those of the other required checks, the same in every repository.\n    workflows: [CI (python), Variants, " %][% set project = "    # The checks of this repository, and its end-to-end tests if a workflow of its own named Docker E2E runs them.\n    # Then those of the other required checks, the same in every repository.\n    workflows: [CI (" ~ ci_workflow ~ ")" ~ (", Action test" if project_type == 'github-action' else "") ~ ", Docker E2E, " %][% filter replace(workflows, project) %][% include ".github/workflows/after-checks.yml" %][% endfilter -%]
