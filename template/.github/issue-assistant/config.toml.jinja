# Settings of the issue assistant: https://github.com/Dennis-Otto/issue-assistant

[engine]
# The AI engine that writes the analysis; its secret belongs to the environment
# issue-assistant. Leave out model for the engine's default.
name = "claude"
# The most AI runs that people who don't maintain the repository start: analyses
# of new issues, follow-ups and replies after a release in 24 hours, analyses of
# one reporter's new issues in 24 hours, and comments of a reporter after a release
# closed their issue that the AI reads. Over a limit, the issue gets its labels and
# waits for the maintainer; 0 lets only maintainers start the AI, by hand.
max_per_day = 20
max_per_author_per_day = 3
release_replies = 2

[links]
# Hosts that links in the assistant's comments may lead to, besides this repository.
hosts = [[% if stack == 'home-assistant' %]"www.home-assistant.io", "developers.home-assistant.io", "hacs.xyz"[% elif stack == 'php' %]"docs.nextcloud.com", "apps.nextcloud.com"[% elif project_type == 'github-action' %]"docs.github.com"[% elif project_type == 'python-package' %]"docs.python.org", "pypi.org"[% elif stack == 'node' %]"nodejs.org", "www.npmjs.com"[% elif stack == 'container' %]"docs.docker.com"[% endif %]]

[forms]
# The dropdown of the issue forms whose answer chooses an area label, and the
# answers that choose none.
area_field = "Area"
unmapped_options = ["Other"]

[transparency]
# Files that tell reporters which AI reads their issue; the check command makes sure
# they name the engine.[% if issue_assistant_ai %]
files = ["SUPPORT.md"][% else %] None: the repository variable ISSUE_ASSISTANT_AI
# switches the AI off, and SUPPORT.md says that no AI reads the issues.
files = [][% endif %]

[releases]
# A merged pull request that fixes an issue labels it fixed-in-next-release; the
# issue closes with a link to the first release that ships the fix.
close_with_release = true
