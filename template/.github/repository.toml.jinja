# The settings of the repository as code. `blueprint.py settings check` compares them
# with GitHub, and `blueprint.py settings apply` sets them:
# https://github.com/Dennis-Otto/repo-blueprint#settings-as-code

[repository]
description = {= description | to_json(ensure_ascii=False) =}
homepage = {= homepage | to_json(ensure_ascii=False) =}
topics = {= topics.split(',') | map('trim') | select | list | to_json(ensure_ascii=False) =}
has_issues = true
has_discussions = {= discussions | lower =}
has_projects = false
has_wiki = false
allow_squash_merge = true
allow_merge_commit = false
allow_rebase_merge = false
allow_auto_merge = true
allow_update_branch = true
delete_branch_on_merge = true
squash_merge_commit_title = "PR_TITLE"
squash_merge_commit_message = "PR_BODY"
# The DCO sign-off also for commits made on github.com.
web_commit_signoff_required = true

[security]
# A published release keeps its tag and assets; title and notes stay editable.
immutable_releases = true
private_vulnerability_reporting = true
dependabot_alerts = true
# Renovate opens the updates that fix a vulnerability.
dependabot_security_updates = false
secret_scanning = true
secret_scanning_push_protection = true
# Generic secrets as well, such as private keys, connection strings and passwords
# that no provider issued: alerts in the Security tab.
secret_scanning_non_provider_patterns = true

[actions]
default_workflow_permissions = "read"
can_approve_pull_request_reviews = false
sha_pinning_required = true
# Workflows of pull requests from forks wait for the maintainer's approval.
fork_pr_approval = "all_external_contributors"
# Only the actions of GitHub and those of [actions.selected] may run, also in a
# workflow that a pull request changes; those of this repository always may. A step
# that runs an image with docker:// is an action that no pattern allows: it runs the
# image with docker run instead.
allowed_actions = "selected"

# The actions and reusable workflows that the workflows name, and those that these run
# in turn. `blueprint.py settings check` names each one that a workflow runs and this
# list lacks, and the settings bot only adds to the list on GitHub until it's added;
# add those of this project alone in .github/repository.project.toml.
[actions.selected]
github_owned_allowed = true
verified_allowed = false
patterns_allowed = [
  "anchore/sbom-action@*",
  # Run by the reusable workflow of the issue assistant.
  "anthropics/claude-code-action@*",
  "astral-sh/setup-uv@*",
  "DavidAnson/markdownlint-cli2-action@*",
  "Dennis-Otto/issue-assistant/.github/workflows/reusable-findings.yml@*",
  "Dennis-Otto/issue-assistant/.github/workflows/reusable-issue-assistant.yml@*",
  "Dennis-Otto/issue-assistant/.github/workflows/reusable-issue-lifecycle.yml@*",
  "Dennis-Otto/issue-assistant/.github/workflows/reusable-labels.yml@*",
  "Dennis-Otto/issue-assistant@*",
  "dependabot/fetch-metadata@*",
  "docker/build-push-action@*",
  "docker/login-action@*",
  "docker/metadata-action@*",
  "docker/setup-buildx-action@*",
  "docker/setup-qemu-action@*",
  "fsfe/reuse-action@*",
  "gitleaks/gitleaks-action@*",
  "google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@*",
  "google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@*",
  # Run by the reusable workflows of OSV-Scanner.
  "google/osv-scanner-action/osv-reporter-action@*",
  "google/osv-scanner-action/osv-scanner-action@*",
  "googleapis/release-please-action@*",
  "lycheeverse/lychee-action@*",
  # Run by the reusable workflow of the issue assistant.
  "openai/codex-action@*",
  "ossf/scorecard-action@*",
  # Run by anthropics/claude-code-action.
  "oven-sh/setup-bun@*",
  "pypa/gh-action-pypi-publish@*",[% if renovate_runner == 'self' %]
  # The Renovate workflow of this repository.
  "renovatebot/github-action@*",[% endif %]
  "shivammathur/setup-php@*",
  "step-security/harden-runner@*",
  "zizmorcore/zizmor-action@*",
]

# The checks every pull request into main must pass.
[branch]
required_checks = [
  "check ({= ci_workflow =})",[% if project_type == 'github-action' %]
  "action",[% endif %][% if stack == 'home-assistant' %]
  # HACS and hassfest.
  "home-assistant",[% endif %]
  # Every linter, the workflows, the licenses, the Markdown, the issue assistant
  # and the sign-off of every commit, in one job.
  "lint",
  "diagrams",
  "docs",
  # The title of the pull request and its entry in the changelog.
  "conventional title",
  "codeql",
  "dependency-review",
  "gitleaks",
]
# A new alert of a tool of code scanning in a pull request stops its merge from these
# thresholds on; an alert that main has already doesn't. Only a tool that analyzes
# every pull request belongs here, because a missing analysis stops the merge too.
code_scanning_tools = [
  { tool = "CodeQL", alerts_threshold = "errors", security_alerts_threshold = "high_or_higher" },
]

[variables]
PUBLISH_TO = "{= publish_to =}"
[%- if release_app %]
# The GitHub App that opens the release pull requests, so that their checks run, by
# the name in its address: https://github.com/apps/{= release_app =}
RELEASE_APP = "{= release_app =}"
RELEASE_AUTOMATION_CLIENT_ID = "{= release_app_client_id =}"
# Its App ID: only this app may create release tags, which the release workflow signs.
RELEASE_AUTOMATION_APP_ID = "{= release_app_id =}"
[%- else %]
# No release app yet, which opens the release pull requests, signs the release tags
# and runs the bots: `python3 .github/blueprint.py checklist` shows how to register
# one, and `copier update` with its answers names it here.
[%- endif %]
# Whether the issue assistant analyzes each new issue with its AI engine, by the
# answer issue_assistant_ai of the blueprint. "off" labels the issues and answers
# the commands without an engine, which needs no secret; the settings bot sets the
# variable either way, so a later answer turns the AI on or off again.
ISSUE_ASSISTANT_AI = "{= 'on' if issue_assistant_ai else 'off' =}"

# GitHub Pages, which publishes the website that the Docs workflow builds from
# mkdocs.yml and docs/.
[pages]
build_type = "workflow"

# Environments and the secrets they need; only main may use them.
[environments.release]
secrets = [{= ((["RELEASE_AUTOMATION_PRIVATE_KEY"] if release_app else []) + (["APP_PRIVATE_KEY", "APPSTORE_TOKEN"] if publish_to == 'nextcloud-appstore' else [])) | map('to_json') | join(', ') =}]

[environments.issue-assistant]
[%- if issue_assistant_ai %]
secrets = ["CLAUDE_CODE_OAUTH_TOKEN"]
[%- else %]
# No AI engine and no secret of one; only main may use the environment still.
secrets = []
[%- endif %]
[% if publish_to == 'pypi' %]
[environments.pypi]
secrets = []
[% elif publish_to == 'npm' %]
[environments.npm]
secrets = []
[% endif -%]
