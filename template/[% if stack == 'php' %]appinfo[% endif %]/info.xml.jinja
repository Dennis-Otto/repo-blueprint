<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>{= nextcloud_app_id =}</id>
	<name>{= project_name | e =}</name>
	<summary>{= description | e =}</summary>
	<description><![CDATA[
{= description =}
]]></description>
	<version>0.0.0</version>
	<licence>{= license =}</licence>
	<author homepage="https://github.com/{= owner =}">{= author | e =}</author>
	<namespace>{= nextcloud_namespace =}</namespace>
[%- set repository = 'https://github.com/' ~ owner ~ '/' ~ project_slug %]
[#- The App Store takes addresses of https only. #]
[%- set website = homepage if homepage.startswith('https://') else '' %]
	<documentation>
		<user>{= (website or repository ~ '#readme') | e =}</user>
	</documentation>
	<category>tools</category>
	<website>{= (website or repository) | e =}</website>
[%- if discussions %]
	<discussion>{= repository =}/discussions</discussion>
[%- endif %]
	<bugs>{= repository =}/issues</bugs>
	<repository type="git">{= repository =}.git</repository>
[%- if sponsor %]
	<donation type="other" title="GitHub Sponsors">https://github.com/sponsors/{= sponsor =}</donation>
[%- endif %]
	<dependencies>
		<php min-version="8.2"/>
		<nextcloud min-version="33" max-version="35"/>
	</dependencies>
</info>
