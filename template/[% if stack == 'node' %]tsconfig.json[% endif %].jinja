{
  "compilerOptions": {
[%- if project_type == 'cloudflare-worker' %]
    "target": "es2024",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
[%- elif project_type == 'chrome-extension' %]
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "chrome"],
[%- else %]
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
[%- endif %]
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
[%- if project_type == 'cloudflare-worker' %]
    "allowImportingTsExtensions": true,
[%- else %]
    "rewriteRelativeImportExtensions": true,
[%- endif %]
    "forceConsistentCasingInFileNames": true,
    "noEmit": true[% if project_type == 'chrome-extension' %],
    // A file that imports and exports nothing is a classic script, as the content
    // script, src/content.ts, has to be: the compiler then writes it without an
    // `export {}`, which a content script can't run. Every other file is a module.
    "moduleDetection": "legacy"[% endif %]
  },
  "include": ["src", "test"]
}
