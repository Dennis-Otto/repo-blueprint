{
	"name": "blueprint/nextcloud-app",
	"description": "Development tools of the Nextcloud apps of the blueprint",
	"type": "nextcloud-app",
	"license": "AGPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"OCA\\Blueprint\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Blueprint\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": "^8.2",
		"ext-ctype": "*",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-fileinfo": "*",
		"ext-filter": "*",
		"ext-libxml": "*",
		"ext-mbstring": "*",
		"ext-openssl": "*",
		"ext-pdo": "*",
		"ext-session": "*",
		"ext-simplexml": "*",
		"ext-xml": "*",
		"ext-xmlreader": "*",
		"ext-xmlwriter": "*",
		"ext-zlib": "*"
	},
	"require-dev": {
		"nextcloud/coding-standard": "^1.5",
		"nextcloud/ocp": "^33.0",
		"phpunit/phpunit": "^12.5",
		"vimeo/psalm": "^7.0"
	},
	"scripts": {
		"check": "bash scripts/check.sh",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"platform": {
			"php": "8.3.16"
		},
		"sort-packages": true
	}
}
