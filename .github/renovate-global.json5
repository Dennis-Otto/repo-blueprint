// The settings of the Renovate bot itself, for the Renovate workflow, which names the
// repositories and the bot user of the release app that it runs as. The rules of the
// updates are in the .github/renovate.json5 of each repository.
// https://docs.renovatebot.com/self-hosted-configuration/
{
  platform: "github",
  // Only a repository that has a .github/renovate.json5, which the blueprint brings,
  // and no onboarding pull request.
  onboarding: false,
  requireConfig: "required",
  // Commits through the API, which GitHub signs, as main requires signed commits.
  platformCommit: "enabled",
  // The package managers write the lock files with their scripts switched off.
  allowScripts: false,
  // The one command that a rule may run after an update: pins.py of the blueprint,
  // which writes the sha256 of a tool that Renovate moved to a new release. It runs
  // without a shell and without the bot's environment, but the checkout it runs in
  // still holds the token of the release app in .git/config: pins.py runs nothing
  // that it downloads, and a change of it is reviewed like one of a workflow.
  allowedCommands: ["^python3 pins\\.py$"],
  binarySource: "install",
}
