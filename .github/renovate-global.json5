// The settings of the Renovate bot itself, for the Renovate workflow, which names the
// repositories and the bot user of the release app that it runs as. The rules of the
// updates are in the .github/renovate.json5 of each repository.
// https://docs.renovatebot.com/self-hosted-configuration/
{
  platform: "github",
  // Only a repository that has a .github/renovate.json5, which the blueprint brings,
  // and no onboarding pull request.
  onboarding: false,
  requireConfig: "required",
  // Commits through the API, which GitHub signs, as main requires signed commits.
  platformCommit: "enabled",
  // The package managers write the lock files with their scripts switched off.
  allowScripts: false,
  // The commands that a rule may run after an update. They run without a shell and
  // without the bot's environment, but the checkout they run in still holds the
  // token of the release app in .git/config, so a change of one is reviewed like one
  // of a workflow. blueprint.py of the repository compiles the lock files of
  // pip-compile of the weekly refresh again from versions a week old, with uv, as
  // Renovate itself compiles them in the same checkout (decision 0136).
  allowedCommands: [
    "^python3 (?:\\.github/)?blueprint\\.py locks --refresh$",
    // The blueprint's own pins.py writes the sha256 of a tool that Renovate moved to
    // a new release, and runs nothing that it downloads.
    "^python3 pins\\.py$",
  ],
  binarySource: "install",
}
