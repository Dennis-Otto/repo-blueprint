// Renovate for the blueprint: the rules of the blueprint in
// .github/renovate-blueprint.json5, then its own below. What new repositories copy,
// or what reaches every repository through the blueprint bot, is committed as
// fix(deps) and leads to a patch release that merges itself once every check
// passes: the actions of the workflows, the images, the tools that the workflows
// download, Copier and the tools of each kind of project in stacks/. The tools of
// the blueprint's own tests stay chore(deps) and wait for the next release.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/repo-blueprint//.github/renovate-blueprint.json5"],
  customManagers: [
    {
      // The release of Mermaid that the hook of every website names for Material,
      // which reaches every repository with the hook.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/mkdocs_blueprint\\.py$/"],
      matchStrings: [
        "https://unpkg\\.com/(?<depName>mermaid)@(?<currentValue>\\d+\\.\\d+\\.\\d+)/dist/mermaid\\.min\\.js",
      ],
      datasourceTemplate: "npm",
    },
    {
      // The Copier of the quick start in the READMEs, with uv and with pipx, that of
      // the one-liner on the page of each kind, and those of the walkthrough for an
      // owner's own account, which GitHub shows too, so it takes no snippet.
      customType: "regex",
      managerFilePatterns: [
        "/^README(\\.de)?\\.md$/",
        "/^docs/kinds/[a-z-]+(\\.de)?\\.md$/",
        "/^docs/own-account(\\.de)?\\.md$/",
        "/^blueprint/app\\.py$/",
      ],
      matchStrings: [
        "(?<depName>copier)==(?<currentValue>\\d+\\.\\d+\\.\\d+) copier (?:copy|update)",
      ],
      datasourceTemplate: "pypi",
    },
    {
      // The Home Assistant and the Nextcloud of the pictures of a new repository,
      // by tag and digest, in the template of its scripts/screenshots.sh.
      customType: "regex",
      managerFilePatterns: ["/^template/scripts/.*screenshots\\.sh.*\\.jinja$/"],
      matchStrings: [
        "(?:^|[\\s\"'=])(?<depName>[a-z0-9][a-z0-9._-]*(?:/[a-z0-9._-]+)+):(?<currentValue>v?\\d[a-zA-Z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // The Renovate of the Renovate workflow, pinned by digest, follows the line
      // "# renovate:" above it rather than the action's own reading of the input.
      matchManagers: ["github-actions"],
      matchDepNames: ["ghcr.io/renovatebot/renovate"],
      enabled: false,
    },
    {
      matchFileNames: ["**"],
      semanticCommitType: "fix",
    },
    {
      // The tools of the prose check, which every repository gets from here.
      matchFileNames: [".github/prose/**"],
      enabled: true,
      groupName: "the tools of the prose check",
    },
    {
      // The tools of the accessibility check of the websites, which every repository
      // gets from here.
      matchFileNames: [".github/a11y/**"],
      enabled: true,
      groupName: "the tools of the accessibility check",
    },
    {
      // The Mermaid that every website draws its diagrams with, within the major
      // version that Material loads: .github/mkdocs_blueprint.py warns when Material
      // loads another one, which fails the check docs, and then both move.
      matchManagers: ["custom.regex"],
      matchDepNames: ["mermaid"],
      allowedVersions: "<12",
      groupName: "the tools of the websites",
    },
    {
      // The uv that the workflows set up, which every repository gets from here.
      matchManagers: ["custom.regex"],
      matchDepNames: ["uv"],
      matchFileNames: [".github/workflows/**"],
      enabled: true,
    },
    {
      // The tools that the workflows and .github/sign-tag.sh download and check by
      // their sha256, which every repository gets from here. Renovate can't know the
      // checksum of a new release: after it moved a version, pins.py downloads the
      // release and writes its sha256 beside the version and into .github/pins.toml,
      // so that the update merges on its own like any other.
      matchManagers: ["custom.regex"],
      matchDepNames: ["sigstore/gitsign", "infection/infection", "ChristophWurst/krankerl", "nextcloud/server", "anchore/syft"],
      matchFileNames: [".github/workflows/**", ".github/sign-tag.sh"],
      enabled: true,
      postUpgradeTasks: {
        commands: ["python3 pins.py"],
        fileFilters: [".github/pins.toml", ".github/sign-tag.sh", ".github/workflows/*.yml"],
        executionMode: "branch",
      },
    },
    {
      matchFileNames: ["requirements-dev.txt"],
      semanticCommitType: "chore",
      groupName: "the tools of the blueprint's tests",
    },
    {
      matchFileNames: ["stacks/copier/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Copier",
    },
    {
      // The quick start copies with the Copier that the blueprint bot updates with.
      matchManagers: ["custom.regex"],
      matchDepNames: ["copier"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Copier",
    },
    {
      matchFileNames: ["stacks/python/**", "stacks/fuzz/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Python packages",
    },
    {
      matchFileNames: ["stacks/home-assistant/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Home Assistant integrations",
    },
    {
      matchFileNames: ["stacks/php/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Nextcloud apps",
    },
    {
      // As in the Nextcloud apps: only releases that run on the PHP of their tools,
      // the platform of stacks/php/composer.json, each major version on its own, and
      // the public API of Nextcloud within its major version.
      matchFileNames: ["stacks/php/**"],
      constraints: { php: "8.3.*" },
      constraintsFiltering: "strict",
      separateMultipleMajor: true,
    },
    {
      // The filter above lets PHPUnit 13 through, which needs PHP 8.4.
      matchFileNames: ["stacks/php/**"],
      matchDepNames: ["phpunit/phpunit"],
      allowedVersions: "<13",
    },
    {
      matchFileNames: ["stacks/php/**"],
      matchDepNames: ["nextcloud/ocp"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchFileNames: ["stacks/node/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Node packages",
    },
    {
      matchFileNames: ["stacks/docs/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the websites",
    },
    {
      // The Nextcloud of the pictures of a new app stays within the max-version of
      // its appinfo/info.xml, which tests/test_template.py checks: a new major
      // version moves with that by hand.
      matchFileNames: ["template/scripts/**"],
      matchDepNames: ["docker.io/library/nextcloud"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // The browser of the screenshots and the Playwright that drives it move
      // together: the image of .github/social-preview/Dockerfile holds the browsers of
      // one version of Playwright, stacks/screenshots/requirements-browser.txt the
      // package of the same version, which tests/test_template.py keeps equal.
      matchDepNames: ["mcr.microsoft.com/playwright/python", "playwright"],
      groupName: "Playwright",
    },
  ],
}
