// Renovate for the blueprint: the rules of the blueprint in
// .github/renovate-blueprint.json5, then its own below. What new repositories copy,
// or what reaches every repository through the blueprint bot, is committed as
// fix(deps) and leads to a patch release that merges itself once every check
// passes: the actions of the workflows, the images, the tools that the workflows
// download, Copier and the tools of each kind of project in stacks/. The tools of
// the blueprint's own tests stay chore(deps) and wait for the next release.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/repo-blueprint//.github/renovate-blueprint.json5"],
  packageRules: [
    {
      // The Renovate of the Renovate workflow, pinned by digest, follows the line
      // "# renovate:" above it rather than the action's own reading of the input.
      matchManagers: ["github-actions"],
      matchDepNames: ["ghcr.io/renovatebot/renovate"],
      enabled: false,
    },
    {
      matchFileNames: ["**"],
      semanticCommitType: "fix",
    },
    {
      // The tools of the prose check, which every repository gets from here.
      matchFileNames: [".github/prose/**"],
      enabled: true,
      groupName: "the tools of the prose check",
    },
    {
      // The uv that the workflows set up, which every repository gets from here.
      matchManagers: ["custom.regex"],
      matchDepNames: ["uv"],
      matchFileNames: [".github/workflows/**"],
      enabled: true,
    },
    {
      // The tools that the workflows and .github/sign-tag.sh download and check by
      // their sha256, which every repository gets from here. Renovate can't know the
      // checksum of a new release: after it moved a version, pins.py downloads the
      // release and writes its sha256 beside the version and into .github/pins.toml,
      // so that the update merges on its own like any other.
      matchManagers: ["custom.regex"],
      matchDepNames: ["sigstore/gitsign", "infection/infection", "ChristophWurst/krankerl", "nextcloud/server", "anchore/syft"],
      matchFileNames: [".github/workflows/**", ".github/sign-tag.sh"],
      enabled: true,
      postUpgradeTasks: {
        commands: ["python3 pins.py"],
        fileFilters: [".github/pins.toml", ".github/sign-tag.sh", ".github/workflows/*.yml"],
        executionMode: "branch",
      },
    },
    {
      matchFileNames: ["requirements-dev.txt"],
      semanticCommitType: "chore",
      groupName: "the tools of the blueprint's tests",
    },
    {
      matchFileNames: ["stacks/copier/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Copier",
    },
    {
      matchFileNames: ["stacks/python/**", "stacks/fuzz/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Python packages",
    },
    {
      matchFileNames: ["stacks/home-assistant/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Home Assistant integrations",
    },
    {
      matchFileNames: ["stacks/php/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Nextcloud apps",
    },
    {
      // As in the Nextcloud apps: only releases that run on the PHP of their tools,
      // the platform of stacks/php/composer.json, each major version on its own, and
      // the public API of Nextcloud within its major version.
      matchFileNames: ["stacks/php/**"],
      constraints: { php: "8.3.*" },
      constraintsFiltering: "strict",
      separateMultipleMajor: true,
    },
    {
      // The filter above lets PHPUnit 13 through, which needs PHP 8.4.
      matchFileNames: ["stacks/php/**"],
      matchDepNames: ["phpunit/phpunit"],
      allowedVersions: "<13",
    },
    {
      matchFileNames: ["stacks/php/**"],
      matchDepNames: ["nextcloud/ocp"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchFileNames: ["stacks/node/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the Node packages",
    },
    {
      matchFileNames: ["stacks/docs/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "the tools of the websites",
    },
  ],
}
